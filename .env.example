 # ================================================================================
# SHEIN Web Scraper - Environment Configuration
# ================================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ================================================================================

# --- Google Gemini API Key(s) ---
# Required for AI-powered CAPTCHA solving.
# Multiple keys can be comma-separated for automatic failover:
#   Named format: OwnerName1:API_KEY1,OwnerName2:API_KEY2
#   Legacy format: API_KEY1,API_KEY2
#
# Get your free API key at: https://aistudio.google.com/apikey
# Free tier allows ~1500 requests/day.
GEMINI_API_KEY=Main:YOUR_GEMINI_API_KEY_HERE

# --- Chrome Profile (Optional but Recommended) ---
# Path to an existing Chrome profile directory for persistent sessions.
# If left empty, a temporary profile will be created.
CHROME_PROFILE_PATH=./ChromeProfile

# --- Chrome Executable Path (Optional) ---
# Path to the Chrome/Chromium executable.
# If left empty, the system default Chrome will be used.
CHROME_EXECUTABLE_PATH=

# --- Headless Mode (Optional) ---
# Set to "true" to run the browser in headless mode (no GUI).
# IMPORTANT: Headless mode may increase CAPTCHA triggers from SHEIN.
HEADLESS=false
